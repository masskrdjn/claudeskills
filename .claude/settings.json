{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "xhigh" },
    "claude-sonnet-5-5": { "effortLevel": "medium" },
    "claude-haiku-5-5": { "effortLevel": "medium" }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task|TaskOutput",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent_identity.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
